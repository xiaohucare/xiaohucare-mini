# =============================================================================
# xiaohucare-min 环境变量模板
#
# 使用方法：cp .env.example .env，按需填写后 `set -a; source .env; set +a`
# 说明：
#   - 本文件只列变量名与非敏感默认值（与各 application*.yml 中的 ${ENV:默认} 对应）
#   - 标注【敏感】的变量禁止填写真实值提交进仓库，仅在本地 .env / 部署环境注入
#   - 未列出的变量走 yml 中的内置默认值即可
# =============================================================================

# ---------- 应用基础 ----------
# 文件上传路径（Linux 生产建议 /home/xiaohucare/uploadPath）
XIAOHUCARE_PROFILE=./uploadPath
SERVER_PORT=8187
SERVER_CONTEXT_PATH=/xiaohucare-api
CAPTCHA_TYPE=math
DEVTOOLS_RESTART=false
THYMELEAF_CACHE=true
LOG_LEVEL_APP=info
LOG_LEVEL_SPRING=warn
LOG_LEVEL_LANGCHAIN=info

# ---------- 鉴权令牌 ----------
# 【敏感】JWT 密钥，≥ 32 字节，生成示例：openssl rand -base64 48
XIAOHUCARE_TOKEN_SECRET=
TOKEN_EXPIRE_TIME=30

# ---------- 数据库 MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
# 开发库默认 xiaohucare_demo，生产打包模板默认 xiaohucare_min
DB_NAME=xiaohucare_demo
# 【敏感】生产必须注入，禁用 root 直连业务
DB_USERNAME=
DB_PASSWORD=
DB_USE_SSL=false

# ---------- Druid 监控 ----------
DRUID_MONITOR_ENABLED=false
# 【敏感】开启监控时必填，否则启动失败
DRUID_MONITOR_USERNAME=
DRUID_MONITOR_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=9
REDIS_KEY_PREFIX=xiaohucare:
# 【敏感】
REDIS_PASSWORD=

# ---------- 接口文档 Knife4j ----------
KNIFE4J_ENABLE=false
KNIFE4J_PRODUCTION=true
KNIFE4J_TITLE=小护康养 mini API 文档
KNIFE4J_CONTACT_NAME=xiaohucare
KNIFE4J_CONTACT_URL=
KNIFE4J_CONTACT_EMAIL=
KNIFE4J_BASIC_ENABLE=false
KNIFE4J_BASIC_USERNAME=
KNIFE4J_BASIC_PASSWORD=

# ---------- 防盗链 ----------
REFERER_ENABLED=false
REFERER_ALLOWED_DOMAINS=localhost,127.0.0.1

# ---------- 对象存储（按 OSS_TYPE 选一套填写）----------
# local / aliyun / huawei / rustfs
OSS_TYPE=local
OSS_LOCAL_ENABLED=true
OSS_LOCAL_PATH=./uploadPath/oss/local
OSS_LOCAL_DOMAIN=
OSS_LOCAL_HTTPS=false

OSS_ALIYUN_ENABLED=false
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_DOMAIN=
# 【敏感】云 AK/SK
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

OSS_HUAWEI_ENABLED=false
HUAWEI_OSS_ENDPOINT=obs.cn-east-3.myhuaweicloud.com
HUAWEI_OSS_REGION=cn-east-3
HUAWEI_OSS_BUCKET=
# 【敏感】云 AK/SK
HUAWEI_OSS_ACCESS_KEY_ID=
HUAWEI_OSS_ACCESS_KEY_SECRET=

OSS_RUSTFS_ENABLED=false
RUSTFS_API_URL=http://localhost:8080/api
# 【敏感】
RUSTFS_APP_ID=
RUSTFS_APP_SECRET=

# ---------- 定时任务 XXL-JOB（可选）----------
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:8080/
XXL_JOB_EXECUTOR_APP=xiaohucare-executor
XXL_JOB_EXECUTOR_PORT=8189
XXL_JOB_LOG_PATH=./xxl-job/platform
# 【敏感】
XXL_JOB_ACCESS_TOKEN=

# ---------- GPS 时序数据 InfluxDB（可选）----------
DATA_STORAGE_ENABLED=false
DATA_STORAGE_TYPE=influxdb
INFLUXDB_URL=
INFLUXDB_ORG=
INFLUXDB_BUCKET=
# 【敏感】
INFLUXDB_TOKEN=

# ---------- 向量库（AI 知识库，按 VECTOR_STORE_TYPE 选一套）----------
VECTOR_STORE_TYPE=weaviate
WEAVIATE_PROTOCOL=http
WEAVIATE_HOST=127.0.0.1:8099
WEAVIATE_CLASSNAME=LocalKnowledge

QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION_NAME=LocalKnowledge
QDRANT_USE_TLS=false
# 【敏感】
QDRANT_API_KEY=

MILVUS_URL=http://localhost:19530
MILVUS_COLLECTION_NAME=LocalKnowledge

# ---------- 微信小程序 / 支付 ----------
WX_PLAT_APP=
# 测试支付开关，生产必须为 0
APP_TEST_PAY=0
APP_WX_QR=1
