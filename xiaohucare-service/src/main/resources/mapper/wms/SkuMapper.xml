<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaohucare.app.care.wms.mapper.SkuMapper">

    <resultMap id="SkuVOResultMap" type="com.xiaohucare.app.care.wms.vo.SkuVO">
        <id property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="skuCode" column="sku_code"/>
        <result property="skuName" column="sku_name"/>
        <result property="productImage" column="product_image"/>
        <result property="specifications" column="specifications"/>
        <result property="purchasePrice" column="purchase_price"/>
        <result property="salePrice" column="sale_price"/>
        <result property="marketPrice" column="market_price"/>
        <result property="totalStock" column="total_stock"/>
        <result property="warningStock" column="warning_stock"/>
        <result property="status" column="status"/>
        <result property="createAt" column="create_at"/>
        <result property="updateAt" column="update_at"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <!-- 连表查询字段 -->
        <result property="productName" column="product_name"/>
        <result property="marketPrice" column="market_price"/>
        <result property="unit" column="unit"/>
        <result property="specText" column="spec_text"/>
    </resultMap>

    <!-- 分页查询SKU（含商品名称、单位、规格） -->
    <select id="selectSkuPage" resultMap="SkuVOResultMap">
        SELECT
            s.id,
            s.product_id,
            s.category_id,
            s.sku_code,
            s.sku_name,
            s.product_image,
            s.specifications,
            s.purchase_price,
            s.sale_price,
            s.market_price,
            s.total_stock,
            s.warning_stock,
            s.status,
            s.create_at,
            s.update_at,
            s.create_by,
            s.update_by,
            p.product_name,
            p.market_price,
            p.unit,
            -- 从 JSON 中提取规格文本（简化显示）
            CASE 
                WHEN s.specifications IS NOT NULL AND s.specifications != '' 
                THEN REPLACE(REPLACE(s.specifications, '{"', ''), '":"', ': ')
                ELSE '-'
            END AS spec_text
        FROM e_wms_sku s
        LEFT JOIN e_wms_product p ON s.product_id = p.id
        <where>
            s.is_delete = 0
            AND s.status = 1
            <if test="params.productName != null and params.productName != ''">
                AND p.product_name LIKE CONCAT('%', #{params.productName}, '%')
            </if>
             <if test="params.categoryId != null and params.categoryId != ''">
                AND s.category_id = #{params.categoryId}
            </if>
            <if test="params.skuCode != null and params.skuCode != ''">
                AND s.sku_code LIKE CONCAT('%', #{params.skuCode}, '%')
            </if>
            <if test="params.stockStatus == 'warning'">
                AND s.total_stock &lt;= s.warning_stock AND s.total_stock > 0
            </if>
            <if test="params.stockStatus == 'out' or params.stockStatus == 'out_of_stock'">
                AND s.total_stock = 0
            </if>
            <if test="params.stockStatus == 'normal'">
                AND s.total_stock > s.warning_stock
            </if>
        </where>
        ORDER BY s.id DESC
    </select>

</mapper>
